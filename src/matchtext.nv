// matchtext.nv — the matchers over a `Str`.
//
// A string matcher fails with the part that mattered.  A subject longer
// than 64 bytes is shown as its first 64 bytes and its length, so a
// failure over a large document stays readable.
//
// The regular-expression matchers run `std.regex`, the standard
// library's engine.  It declares no effects and runs in linear time, so
// no pattern backtracks catastrophically.  Its dialect is a
// Perl-flavoured subset with leftmost-first alternation, closest to Go's
// `regexp`.
//
// I-Regexp (RFC 9485) is the portable core of that dialect: literals,
// `.`, character classes, `|`, `?`, `*`, `+`, `{n,m}` and grouping, with
// no anchors, no backreferences, no lookaround and no lazy quantifiers.
// A pattern outside it may mean something else on another engine.  This
// package accepts such a pattern, and `unportable_construct` names what
// takes it outside the core.
//
// A pattern that does not compile matches nothing, and the mismatch
// quotes the engine's error, so a bad pattern is not mistaken for a
// value that did not match.  A matcher is built before anything is
// judged and cannot answer a `Result`, so the pattern is not refused
// when the matcher is built.  `is_valid_pattern` checks one in advance.

use matchers

// Starts with a prefix.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     println(matchers.describe(matchtext.starts_with("Bearer ")))
//     // : a string starting with "Bearer "
// ```
pub fn starts_with(prefix: Str) -> Matcher<Str>
    Matcher { judge: s => judged(str.starts_with(s, prefix), s),
        expected: "a string starting with " + prefix.debug() }

// Ends with a suffix.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.ends_with(".zst"), "x.zst")
//     println("${hit}")                                     // true
// ```
pub fn ends_with(suffix: Str) -> Matcher<Str>
    Matcher { judge: s => judged(str.ends_with(s, suffix), s),
        expected: "a string ending with " + suffix.debug() }

// Contains a substring.
//
// Named `contains_text` rather than `contains`, because
// `matchcoll.contains` is the one over a list.
//
// The mismatch shows the subject, cut to its first 64 bytes when it is
// longer.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.contains_text("ok"), "not ok")
//     println("${hit}")                                     // true
// ```
pub fn contains_text(part: Str) -> Matcher<Str>
    Matcher { judge: s => judged(str.contains(s, part), s),
        expected: "a string containing " + part.debug() }

// Equal, ignoring ASCII case.
//
// Only the letters A to Z are folded.  Unicode case folding is a table
// and a set of rules, such as the Turkish dotless i and the German sharp
// s, and this matcher applies none of them.  A caller that needs the
// full fold composes `matchcombine.after` with unicode-nv's
// `ucase.fold`.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.equal_ignoring_case("GET"), "get")
//     println("${hit}")                                     // true
// ```
pub fn equal_ignoring_case(want: Str) -> Matcher<Str>
    Matcher { judge: s => judged(ascii_lower(s) == ascii_lower(want), s),
        expected: "equal to " + want.debug() + ", ignoring case" }

// Equal, ignoring leading and trailing whitespace on both sides.
//
// The matcher for output whose trailing newline is an accident of how
// it was captured rather than something a test means to assert.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.equal_trimmed("ok"), "ok\n")
//     println("${hit}")                                     // true
// ```
pub fn equal_trimmed(want: Str) -> Matcher<Str>
    Matcher { judge: s => judged(str.trim(s) == str.trim(want), s),
        expected: "equal to " + want.debug() + ", ignoring surrounding whitespace" }

// The empty string.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.is_blank(), "")
//     println("${hit}")                                     // true
// ```
pub fn is_blank() -> Matcher<Str>
    Matcher { judge: s => judged(str.len(s) == 0, s), expected: "the empty string" }

// A string of exactly `n` bytes.
//
// The length is in bytes, not characters, and the failure says so.  A
// `Str` is UTF-8 and `str.len` counts its bytes.  Counting characters
// means counting grapheme clusters, which unicode-nv does.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     println(matchers.describe(matchtext.has_text_length(3)))
//     // : a string of 3 byte(s)
// ```
pub fn has_text_length(n: Int) -> Matcher<Str>
    Matcher { judge: s => judge_length(n, s),
        expected: "a string of " + str.from_int(n) + " byte(s)" }

// The whole string matches a pattern.
//
// This is `std.regex.match_full`: the pattern has to match the entire
// subject, as RFC 9535's `match()` does.  `contains_regex` is the
// substring form.
//
// A pattern that does not compile matches nothing, and the mismatch
// says the pattern did not compile.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.matches_regex("[0-9]{4}"), "2026")
//     println("${hit}")                                     // true
// ```
pub fn matches_regex(pattern: Str) -> Matcher<Str>
    Matcher { judge: s => judge_regex(pattern, s, true),
        expected: "a string matching the pattern " + pattern.debug() }

// Some part of the string matches a pattern.
//
// This is `std.regex.is_match`, RFC 9535's `search()`.  It is a
// separate function from `matches_regex` rather than a flag, so a call
// site says which of the two it means.
//
// ```novo
// use matchers
// use matchtext
//
// fn main() [io]
//     let hit = matchers.matches(matchtext.contains_regex("[0-9]+"), "in 2026")
//     println("${hit}")                                     // true
// ```
pub fn contains_regex(pattern: Str) -> Matcher<Str>
    Matcher { judge: s => judge_regex(pattern, s, false),
        expected: "a string containing a match of the pattern " + pattern.debug() }

// Whether a pattern compiles, without building a matcher.
//
// For a caller that takes a pattern from a configuration file or a
// command line and wants to refuse it where the refusal can carry a
// line number, rather than discovering it inside a failing assertion.
//
// ```novo
// use matchtext
//
// fn main() [io]
//     let ok = matchtext.is_valid_pattern("[0-9")
//     println("${ok}")                                      // false
// ```
pub fn is_valid_pattern(pattern: Str) -> Bool
    regex.error(pattern) == None

// The construct in a pattern that is this toolchain's rather than
// portable, if any.
//
// `None` for a pattern inside I-Regexp (RFC 9485), the set that means
// the same thing on every engine.  Otherwise the name of what took it
// outside: `"anchor"`, `"backreference"`, `"shorthand class"`,
// `"lookaround"`, `"group option"`, `"lazy quantifier"`,
// `"word boundary"` or `"POSIX class"`.
//
// This is a report, not a refusal.  The matchers accept every construct
// `std.regex` has.
//
// ```novo
// use matchtext
//
// fn main() [io]
//     println(matchtext.unportable_construct("^abc") ?? "portable")
//     // : anchor
// ```
pub fn unportable_construct(pattern: Str) -> ?Str
    let n = str.len(pattern)
    var in_class = false
    // How many of the following bytes an escape has already consumed.
    var skip = 0
    for i in 0..n
        if skip > 0
            skip = skip - 1
            continue
        let c = str.byte_at_or(pattern, i, 0)
        let next = str.byte_at_or(pattern, i + 1, 0)
        if c == '\\'
            if next == 'b' or next == 'B'
                return Some("word boundary")
            if next >= '1' and next <= '9'
                return Some("backreference")
            if next == 'd' or next == 'D' or next == 'w' or next == 'W' or next == 's' or next == 'S'
                return Some("shorthand class")
            if next == 'A' or next == 'z' or next == 'Z'
                return Some("anchor")
            skip = 1
        else if in_class
            if c == '[' and next == ':'
                return Some("POSIX class")
            if c == ']'
                in_class = false
        else if c == '['
            in_class = true
        else if c == '^' or c == '$'
            return Some("anchor")
        else if c == '(' and next == '?'
            let third = str.byte_at_or(pattern, i + 2, 0)
            if third == '=' or third == '!' or third == '<'
                return Some("lookaround")
            return Some("group option")
        else if (c == '*' or c == '+' or c == '?' or c == '}') and next == '?'
            return Some("lazy quantifier")
    None

// The longest string a mismatch prints in full.
const SHOWN_MAX = 64

// A subject as a mismatch prints it: in full when it is short, and as
// its first bytes and its length when it is long.
pub fn shown(s: Str) -> Str
    if str.len(s) <= SHOWN_MAX
        return s.debug()
    str.slice(s, 0, SHOWN_MAX).debug() + "... (" + str.from_int(str.len(s)) + " bytes)"

// A verdict already reached, with the subject as the mismatch.
fn judged(ok: Bool, s: Str) -> MatchOutcome
    if ok
        return matchers.matched()
    matchers.mismatched("was " + shown(s))

// A string with ASCII upper case folded to lower case and every other
// byte kept.
fn ascii_lower(s: Str) -> Str
    var out = ""
    for i in 0..str.len(s)
        let b = str.byte_at_or(s, i, 0)
        if b >= 'A' and b <= 'Z'
            out = out + str.from_byte(b + 32)
        else
            out = out + str.from_byte(b)
    out

// The judgement of `has_text_length`.
fn judge_length(n: Int, s: Str) -> MatchOutcome
    if str.len(s) == n
        return matchers.matched()
    matchers.mismatched("was a string of " + str.from_int(str.len(s)) + " byte(s)")

// The judgement of the two regular-expression matchers.
fn judge_regex(pattern: Str, s: Str, whole: Bool) -> MatchOutcome
    if let Some(why) = regex.error(pattern)
        return matchers.mismatched("could not be judged, because the pattern does not compile: " + why)
    let hit = if whole
        regex.match_full(pattern, s)
    else
        regex.is_match(pattern, s)
    judged(hit, s)
