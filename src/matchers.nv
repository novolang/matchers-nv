// matchers.nv — the representation of a matcher, and the assertions.
//
// A matcher is a struct that holds a function and a sentence:
//
//     pub struct Matcher<T>
//         judge: fn(T) -> MatchOutcome
//         expected: Str
//
// The function judges one value.  The sentence is a noun phrase that
// completes "expected ...".  Every combinator in this package answers
// one.
//
// A matcher is a struct rather than a trait for two reasons.  A trait
// bound carries an effect argument and never a type argument (SPEC
// section 3.6), so a combinator generic over the value type cannot be
// written against a trait.  A trait object is charged the effects of
// every implementation of the trait in the program (SPEC section 5.6),
// and this package declares no effects.  A function in a struct field
// has neither limit.  proptest-core-nv's `PropStrategy<T>` has the same
// shape for the same two reasons.
//
// A matcher is not one enum per kind of value, because a caller could
// not extend such an enum.  `matcher` builds one from a sentence and a
// function, and the result composes with every combinator here.
//
// Hamcrest's three methods, `matches`, `describe` and
// `describeMismatch`, rest on one stored call.  `judge` answers a
// `MatchOutcome` that holds the verdict and, when the value did not
// match, the reason.  The three are functions derived from it, so a
// value is judged once.
//
// The sentence is built when the matcher is built: `equal_to(5)` makes
// `"equal to 5"` at once.  A matcher can then be described without
// judging anything, which is how `all_of` joins the sentences of its
// parts.
//
// A failure reads as one sentence, which `failure_text` assembles:
//
//     the reply: expected a list of length 3, but was a list of length 2

// What one judgement answered.
//
// `mismatch` is `None` exactly when `ok` — not an empty string, because
// "it matched" and "it did not match and the matcher had nothing to say"
// are different facts and a reader of a failure report needs them apart.
//
// ```novo
// use matchers
//
// fn main() [io]
//     println("${matchers.matched().ok}")                   // true
// ```
pub struct MatchOutcome
    // Whether the value matched.
    ok: Bool
    // What was actually found, as a clause that completes "but ...".
    // `None` when `ok`.
    mismatch: ?Str

// A judgement that matched.
//
// ```novo
// use matchers
//
// fn main() [io]
//     match matchers.matched().mismatch
//         Some(_) => println("has a reason")
//         None    => println("no reason needed")            // this one
// ```
pub fn matched() -> MatchOutcome
    MatchOutcome { ok: true, mismatch: None }

// A judgement that did not match, with what was found.
//
// `why` completes the sentence "but ...", so it is a clause and not a
// sentence: `"was 4"`, `"was a list of length 2"`, `"had no element
// equal to 7"`.  A `why` that started with a capital letter or ended in
// a full stop would read wrongly in the one place it is ever shown.
//
// ```novo
// use matchers
//
// fn main() [io]
//     println("${matchers.mismatched("was 4").ok}")         // false
// ```
pub fn mismatched(why: Str) -> MatchOutcome
    MatchOutcome { ok: false, mismatch: Some(why) }

// A rule for judging a value, and the sentence that says what it wants.
//
// ```novo
// use matchers
//
// fn even() -> Matcher<Int>
//     matchers.matcher("an even number", is_even)
//
// fn is_even(n: Int) -> MatchOutcome
//     if n % 2 == 0
//         matchers.matched()
//     else
//         matchers.mismatched("was ${n}, which is odd")
// ```
pub struct Matcher<T>
    // Judge one value.  Total: a matcher never fails, it only answers
    // that the value did not match.
    judge: fn(T) -> MatchOutcome
    // What this matcher is looking for, as a noun phrase that completes
    // "expected ...".  Built when the matcher is built.
    expected: Str

// A matcher from a description and a judging function.
//
// A caller with a rule this package does not have writes it here, and
// the result composes with every combinator.  A matcher over a caller's
// own `Invoice` goes inside `all_of` beside `has_len` and `is_ok`.
//
// `expected` completes "expected ...", so it is a noun phrase: `"an
// even number"`, `"a paid invoice"`, `"between 1 and 10"`.
//
// ```novo
// use matchers
//
// fn positive() -> Matcher<Int>
//     matchers.matcher("a positive number", judge_positive)
//
// fn judge_positive(n: Int) -> MatchOutcome
//     if n > 0
//         matchers.matched()
//     else
//         matchers.mismatched("was ${n}")
// ```
pub fn matcher<T>(expected: Str, judge: fn(T) -> MatchOutcome) -> Matcher<T>
    Matcher { judge: judge, expected: expected }

// Judge a value: did it match, and if not, what was it?
//
// `assert_that` judges with this.  A caller judges without asserting
// with it too, for a validation pass that collects every reason rather
// than stopping at the first.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.check_that(5, matchvalue.equal_to(5)).ok}")   // true
// ```
pub fn check_that<T>(value: T, m: Matcher<T>) -> MatchOutcome
    m.judge(value)

// Whether a value matches — hamcrest's `matches`.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.equal_to(5), 4)}")         // false
// ```
pub fn matches<T>(m: Matcher<T>, value: T) -> Bool
    check_that(value, m).ok

// What a matcher expects — hamcrest's `describe`.
//
// A noun phrase completing "expected ...", which is how it reads in a
// failure and how it reads inside `all_of`'s description.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.equal_to(5)))               // equal to 5
// ```
pub fn describe<T>(m: Matcher<T>) -> Str
    m.expected

// What a matcher found — hamcrest's `describeMismatch`.
//
// A clause completing "but ...".  Answers `""` for a value that
// matched, because there is nothing to describe; a caller that wants to
// know which happened asks `check_that` and reads both.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe_mismatch(matchvalue.equal_to(5), 4))   // was 4
// ```
pub fn describe_mismatch<T>(m: Matcher<T>, value: T) -> Str
    check_that(value, m).mismatch ?? ""

// Assert that a value matches, and fail with a sentence if it does not.
//
// A failure reads
//
//     expected a list of length 3, but was a list of length 2
//
// rather than `expected true, got false`, because the matcher is the
// only thing that knows both halves and it wrote them both.
//
// It declares no effects.  `test.fail` declares none, so a `@test` that
// asserts with this needs no effect it did not already have.
//
// ```novo
// use matchers
// use matchcoll
//
// fn check_the_reply(reply: [Int])
//     let want: Matcher<[Int]> = matchcoll.has_len(3)
//     matchers.assert_that(reply, want)
//     // : expected a list of length 3, but was a list of length 2
//
// fn main() [io]
//     check_the_reply([1, 2, 3])
//     println("three entries")
// ```
pub fn assert_that<T>(value: T, m: Matcher<T>)
    let outcome = check_that(value, m)
    if not outcome.ok
        // cov: skip — runs only when the assertion fails, which fails the calling test
        test.fail(failure_text("", m.expected, outcome.mismatch ?? ""))

// Assert, and name the thing being asserted about.
//
// The same sentence with a subject in front of it:
//
//     the reply: expected a list of length 3, but was a list of length 2
//
// For a table-driven test, where forty rows run the same assertion and
// the message alone cannot say which row failed.  It composes with
// `test.case`: the harness prints the case label and this prints the
// subject.
//
// ```novo
// use matchers
// use matchvalue
//
// fn check_total(total: Int)
//     matchers.assert_that_named("the total", total, matchvalue.equal_to(42))
//     // : the total: expected equal to 42, but was 41
//
// fn main() [io]
//     check_total(42)
//     println("the total is right")
// ```
pub fn assert_that_named<T>(what: Str, value: T, m: Matcher<T>)
    let outcome = check_that(value, m)
    if not outcome.ok
        // cov: skip — runs only when the assertion fails, which fails the calling test
        test.fail(failure_text(what, m.expected, outcome.mismatch ?? ""))

// The sentence a failure is reported as.
//
// Every matcher's failure has this shape.  A caller that builds its own
// report, such as a form that shows six failures at once, uses it
// without going through an assertion.
//
// `what` may be empty, and then the sentence starts at "expected".
//
// ```novo
// use matchers
//
// fn main() [io]
//     println(matchers.failure_text("", "equal to 42", "was 41"))
//     // : expected equal to 42, but was 41
// ```
pub fn failure_text(what: Str, expected: Str, mismatch: Str) -> Str
    let sentence = "expected " + expected + ", but " + mismatch
    if what == ""
        return sentence
    what + ": " + sentence

// The same matcher, saying something else about itself.
//
// Hamcrest's `describedAs`.  It is for a composed matcher whose
// generated description is accurate and hard to read, such as `all_of`
// over five clauses, when the test knows a better name for what it
// checks.  The judging is unchanged, and only the "expected ..." half
// is replaced.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     let m = matchers.described_as("a valid port", matchvalue.between(1, 65535))
//     println(matchers.describe(m))                          // a valid port
// ```
pub fn described_as<T>(expected: Str, m: Matcher<T>) -> Matcher<T>
    Matcher { judge: m.judge, expected: expected }

// A matcher that accepts everything.
//
// The identity of `all_of`, and the placeholder in a composed matcher
// for a field that is not checked.  `field_of("id", read_id,
// matchers.anything())` asserts nothing about the field's value.
//
// ```novo
// use matchers
//
// fn main() [io]
//     // The binding is annotated because a call whose type parameter
//     // appears in no argument has nothing to close it from.
//     let m: Matcher<Int> = matchers.anything()
//     println("${matchers.matches(m, 5)}")                             // true
// ```
pub fn anything<T>() -> Matcher<T>
    matcher("anything", accept_any)

// A matcher that accepts nothing.
//
// The identity of `any_of`, and the way a test says "this branch should
// be unreachable" in a shape that still produces a readable failure
// rather than a bare `test.fail`.
//
// ```novo
// use matchers
//
// fn main() [io]
//     let m: Matcher<Int> = matchers.nothing_at_all()
//     println("${matchers.matches(m, 5)}")                             // false
// ```
pub fn nothing_at_all<T>() -> Matcher<T>
    matcher("nothing", refuse_any)

// The judgement `anything` makes of every value.
fn accept_any<T>(value: T) -> MatchOutcome
    matched()

// The judgement `nothing_at_all` makes of every value.
fn refuse_any<T>(value: T) -> MatchOutcome
    mismatched("was given a value")
