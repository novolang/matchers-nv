// matchcombine.nv — the combinators: matchers built out of matchers.
//
// A combinator says several things about one value, and its failure
// names the clause that failed:
//
//     matchers.assert_that(port, matchcombine.all_of([
//         matchvalue.at_least(1),
//         matchvalue.at_most(65535),
//         matchvalue.not_equal_to(0),
//     ]))
//
// For a port of 70000 the mismatch is `was 70000`, the clause
// `at most 65535`'s own.
//
// `all_of` stops at the first clause that fails, because the rest judge
// a value already known to be wrong.  `any_of` runs every clause,
// because its failure says what each alternative found.
//
// Each combinator takes a list.  `both(a, b)` and `either(a, b)` are
// the list forms for two clauses.

use matchers

// Every one of them.
//
// Short-circuits: the failure names the first clause that did not
// match, and the description is the clauses joined with "and".  An
// empty list matches everything, which is the identity `matchers.anything`
// also gives.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// fn main() [io]
//     let m = matchcombine.all_of([matchvalue.at_least(1), matchvalue.at_most(9)])
//     println(matchers.describe_mismatch(m, 10))
//     // : was 10
// ```
pub fn all_of<T>(ms: [Matcher<T>]) -> Matcher<T>
    Matcher { judge: x => judge_all(ms, x), expected: joined(ms, " and ", "anything") }

// At least one of them.
//
// Every alternative is judged, because a failure says what each of
// them found.  An empty list matches
// nothing, which is the identity `matchers.nothing_at_all` also gives.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// fn main() [io]
//     let m = matchcombine.any_of([matchvalue.equal_to(2), matchvalue.equal_to(3)])
//     println("${matchers.matches(m, 3)}")                  // true
// ```
pub fn any_of<T>(ms: [Matcher<T>]) -> Matcher<T>
    Matcher { judge: x => judge_any(ms, x), expected: "one of: " + joined(ms, ", ", "nothing") }

// Not this one.
//
// Named `is_not` rather than `not`, because `not` is the language's
// boolean operator and a function cannot take the name.  The
// description is the inner matcher's with "not" in front.
// `matchers.described_as` gives a negation a better sentence, and
// `matchvalue.not_equal_to` is the negation of equality in its own
// words.
//
// The mismatch is the value itself, `"was ${value}"`.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchcombine.is_not(matchvalue.equal_to(4)), 5)}")
//     // true
// ```
pub fn is_not<T: Debug>(m: Matcher<T>) -> Matcher<T>
    Matcher { judge: x => judge_not(m, x), expected: "not " + matchers.describe(m) }

// Both of them.
//
// `all_of` for exactly two, because two is the common case and
// `both(a, b)` reads better than a list of two at a call site.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// fn main() [io]
//     let m = matchcombine.both(matchvalue.at_least(1), matchvalue.at_most(9))
//     println("${matchers.matches(m, 5)}")                  // true
// ```
pub fn both<T>(a: Matcher<T>, b: Matcher<T>) -> Matcher<T>
    all_of([a, b])

// One or the other.
//
// `any_of` for exactly two.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// fn main() [io]
//     let m = matchcombine.either(matchvalue.equal_to(2), matchvalue.equal_to(3))
//     println("${matchers.matches(m, 4)}")                  // false
// ```
pub fn either<T>(a: Matcher<T>, b: Matcher<T>) -> Matcher<T>
    any_of([a, b])

// A matcher over the part of a value another function extracts.
//
// Hamcrest's `hasProperty("total", equalTo(42))` looks a field up by
// name at run time, which needs reflection.  This language has no
// reflection, so the caller passes a function `fn(T) -> F` that reads
// the field, and a label to print.  The function is checked by the
// compiler: a misspelled field is a build error here and a run-time
// failure in Hamcrest.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// struct Invoice
//     total: Int
//
// fn invoice_total(i: Invoice) -> Int
//     i.total
//
// fn main() [io]
//     // The binding is annotated because a named function passed where
//     // `fn(T) -> F` is expected does not close `T` or `F` today.
//     let want: Matcher<Int> = matchvalue.equal_to(42)
//     let m: Matcher<Invoice> = matchcombine.field_of("total", invoice_total, want)
//     println(matchers.describe(m))
//     // : total equal to 42
// ```
pub fn field_of<T, F>(label: Str, read: fn(T) -> F, inner: Matcher<F>) -> Matcher<T>
    Matcher { judge: x => judge_field(label, read, inner, x),
        expected: label + " " + matchers.describe(inner) }

// A matcher over a value another function derives.
//
// The same shape as `field_of` with no label, for a projection that is
// a computation rather than a field: a length, a second element, a
// parsed form.  The description is the inner matcher's, so a caller
// usually wraps the result in `matchers.described_as`.
//
// ```novo
// use matchers
// use matchcombine
// use matchvalue
//
// fn doubled(n: Int) -> Int
//     n * 2
//
// fn main() [io]
//     let m: Matcher<Int> = matchcombine.after(doubled, matchvalue.equal_to(10))
//     println("${matchers.matches(m, 5)}")                  // true
// ```
pub fn after<T, F>(read: fn(T) -> F, inner: Matcher<F>) -> Matcher<T>
    Matcher { judge: x => judge_after(read, inner, x), expected: matchers.describe(inner) }

// The matchers' descriptions joined, or `empty` when there are none.
fn joined<T>(ms: [Matcher<T>], sep: Str, empty: Str) -> Str
    if list.len(ms) == 0
        return empty
    var parts: [Str] = []
    for m in ms
        let d = m.expected
        list.push(parts, d)
    str.join(parts, sep)

// The judgement of `all_of`: the first clause that does not match.
fn judge_all<T>(ms: [Matcher<T>], x: T) -> MatchOutcome
    for m in ms
        let o = matchers.check_that(x, m)
        if not o.ok
            return o
    matchers.matched()

// The judgement of `any_of`: every clause, and each distinct mismatch.
fn judge_any<T>(ms: [Matcher<T>], x: T) -> MatchOutcome
    var whys: [Str] = []
    for m in ms
        let o = matchers.check_that(x, m)
        if o.ok
            return matchers.matched()
        let why = o.mismatch ?? ""
        if not list.contains(whys, why)
            list.push(whys, why)
    if list.len(whys) == 0
        return matchers.mismatched("matched nothing, because there were no alternatives")
    matchers.mismatched(str.join(whys, " and "))

// The judgement of `is_not`.
fn judge_not<T: Debug>(m: Matcher<T>, x: T) -> MatchOutcome
    if matchers.matches(m, x)
        return matchers.mismatched("was " + x.debug())
    matchers.matched()

// The judgement of `field_of`: the inner mismatch, labelled.
fn judge_field<T, F>(label: Str, read: fn(T) -> F, inner: Matcher<F>, x: T) -> MatchOutcome
    let o = matchers.check_that(read(x), inner)
    if o.ok
        return o
    matchers.mismatched(label + " " + (o.mismatch ?? ""))

// The judgement of `after`.
fn judge_after<T, F>(read: fn(T) -> F, inner: Matcher<F>, x: T) -> MatchOutcome
    matchers.check_that(read(x), inner)
