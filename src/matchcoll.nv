// matchcoll.nv — the matchers over a list.
//
// Each matcher here fails with the smallest true statement it can make:
// `"was a list of length 2"`, `"had no element equal to 7"`,
// `"element 3 was 9"`.
//
// Membership, order and equality are three matchers.  `contains_all`
// says the elements are present and nothing about where.  `in_order`
// says they appear in that order, with anything between.  `equal_list`
// says the list is exactly that list.
//
// `every_item` and `any_item` take a matcher over an element, and the
// failure names the element that failed.
//
// A length check needs nothing of the element type.  Membership needs
// `Eq` to compare and `Debug` to print what it did not find.

use matchers
use matchvalue

// A list of exactly `n` elements.
//
// The most common collection assertion there is, and the one whose
// failure is worst without a matcher: `"was a list of length 2"` rather
// than `"expected true"`.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.has_len(3)
//     println(matchers.describe_mismatch(m, [1, 2]))
//     // : was a list of length 2
// ```
pub fn has_len<T>(n: Int) -> Matcher<[T]>
    Matcher { judge: xs => judge_len(n, xs), expected: "a list of length " + str.from_int(n) }

// A list with no elements.
//
// `has_len(0)` judges the same way.  The failure says how many elements
// there were.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.is_empty()
//     println("${matchers.matches(m, [])}")                 // true
// ```
pub fn is_empty<T>() -> Matcher<[T]>
    Matcher { judge: xs => judge_len(0, xs), expected: "an empty list" }

// A list with at least one element.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.is_not_empty()
//     println("${matchers.matches(m, [])}")                 // false
// ```
pub fn is_not_empty<T>() -> Matcher<[T]>
    Matcher { judge: judge_not_empty, expected: "a non-empty list" }

// A list containing this element, anywhere.
//
// Membership only: it says nothing about position or about what else is
// there.  `in_order` is the ordered question and `equal_list` the exact
// one.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.contains(7)
//     println(matchers.describe(m))
//     // : a list containing 7
// ```
pub fn contains<T: Eq + Debug>(want: T) -> Matcher<[T]>
    Matcher { judge: xs => judge_contains(want, xs), expected: "a list containing " + want.debug() }

// A list containing every one of these, anywhere, in any order.
//
// The failure names what was missing rather than printing the list.
// Duplicates in `wanted` are not counted: a list containing one 7
// satisfies `contains_all([7, 7])`.  For multiplicity, use `equal_list`
// or a count.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.contains_all([2, 9])
//     println(matchers.describe_mismatch(m, [1, 2]))
//     // : did not contain 9
// ```
pub fn contains_all<T: Eq + Debug>(wanted: [T]) -> Matcher<[T]>
    Matcher { judge: xs => judge_contains_all(wanted, xs),
        expected: "a list containing all of " + matchvalue.debug_list(wanted) }

// A list containing none of these.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.contains_none([9])
//     println("${matchers.matches(m, [1, 2])}")             // true
// ```
pub fn contains_none<T: Eq + Debug>(unwanted: [T]) -> Matcher<[T]>
    Matcher { judge: xs => judge_contains_none(unwanted, xs),
        expected: "a list containing none of " + matchvalue.debug_list(unwanted) }

// A list whose elements are exactly these, in this order.
//
// The strictest of the three: a test that uses it breaks when somebody
// changes a sort.  Its mismatch names the first index that differs and
// the element found there, or the length when one list is a prefix of
// the other.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.equal_list([1, 2])
//     println(matchers.describe_mismatch(m, [1, 3]))
//     // : element 1 was 3
// ```
pub fn equal_list<T: Eq + Debug>(want: [T]) -> Matcher<[T]>
    Matcher { judge: xs => judge_equal_list(want, xs),
        expected: "the list " + matchvalue.debug_list(want) }

// A list in which these appear in this order, with anything between.
//
// For "the log has these lines in this sequence" or "the events
// arrived in this order", where the order is the assertion and the rest
// of the list is not.
//
// ```novo
// use matchers
// use matchcoll
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.in_order([1, 3])
//     println("${matchers.matches(m, [1, 2, 3])}")          // true
// ```
pub fn in_order<T: Eq + Debug>(want: [T]) -> Matcher<[T]>
    Matcher { judge: xs => judge_in_order(want, xs),
        expected: "a list with " + matchvalue.debug_list(want) + " in that order" }

// Every element matches.
//
// An empty list matches, as with every universal quantifier:
// `every_item(is_positive)` over `[]` is true.  A test that meant "and there is at least one"
// composes `matchcombine.both(is_not_empty(), every_item(m))`.
//
// The failure names the index and the element's own mismatch:
// `"element 3 was -1"`.
//
// ```novo
// use matchers
// use matchcoll
// use matchvalue
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.every_item(matchvalue.at_least(0))
//     println(matchers.describe_mismatch(m, [1, 0 - 1]))
//     // : element 1 was -1
// ```
pub fn every_item<T>(m: Matcher<T>) -> Matcher<[T]>
    Matcher { judge: xs => judge_every(m, xs), expected: "every item " + matchers.describe(m) }

// At least one element matches.
//
// An empty list does not match.  The failure says how many elements
// were judged and that none matched, or that the list was empty.
//
// ```novo
// use matchers
// use matchcoll
// use matchvalue
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.any_item(matchvalue.greater_than(2))
//     println("${matchers.matches(m, [1, 2, 3])}")          // true
// ```
pub fn any_item<T>(m: Matcher<T>) -> Matcher<[T]>
    Matcher { judge: xs => judge_any_item(m, xs), expected: "an item " + matchers.describe(m) }

// The element at an index matches.
//
// An index outside the list does not match, and the mismatch gives the
// list's length.
//
// ```novo
// use matchers
// use matchcoll
// use matchvalue
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.item_at(5, matchvalue.equal_to(1))
//     println(matchers.describe_mismatch(m, [1, 2]))
//     // : was a list of length 2, with no element 5
// ```
pub fn item_at<T>(index: Int, m: Matcher<T>) -> Matcher<[T]>
    Matcher { judge: xs => judge_item_at(index, m, xs),
        expected: "item " + str.from_int(index) + " " + matchers.describe(m) }

// A list whose length matches.
//
// `has_len` for a bound rather than an exact number:
// `has_length_that(matchvalue.between(1, 10))`.
//
// ```novo
// use matchers
// use matchcoll
// use matchvalue
//
// fn main() [io]
//     let m: Matcher<[Int]> = matchcoll.has_length_that(matchvalue.at_least(1))
//     println("${matchers.matches(m, [1, 2])}")             // true
// ```
pub fn has_length_that<T>(m: Matcher<Int>) -> Matcher<[T]>
    Matcher { judge: xs => judge_length_that(m, xs),
        expected: "a list of length " + matchers.describe(m) }

// "was a list of length 2".
fn list_of_length<T>(xs: [T]) -> MatchOutcome
    matchers.mismatched("was a list of length " + str.from_int(list.len(xs)))

// The judgement of `has_len` and `is_empty`.
fn judge_len<T>(n: Int, xs: [T]) -> MatchOutcome
    if list.len(xs) == n
        return matchers.matched()
    list_of_length(xs)

// The judgement of `is_not_empty`.
fn judge_not_empty<T>(xs: [T]) -> MatchOutcome
    if list.len(xs) > 0
        return matchers.matched()
    matchers.mismatched("was an empty list")

// The judgement of `contains`.
fn judge_contains<T: Eq + Debug>(want: T, xs: [T]) -> MatchOutcome
    if list.contains(xs, want)
        return matchers.matched()
    matchers.mismatched("had no element equal to " + want.debug())

// The judgement of `contains_all`: every missing value, named.
fn judge_contains_all<T: Eq + Debug>(wanted: [T], xs: [T]) -> MatchOutcome
    var missing: [Str] = []
    for w in wanted
        let text = w.debug()
        if not list.contains(xs, w) and not list.contains(missing, text)
            list.push(missing, text)
    if list.len(missing) == 0
        return matchers.matched()
    matchers.mismatched("did not contain " + str.join(missing, ", "))

// The judgement of `contains_none`: every unwanted value found, named.
fn judge_contains_none<T: Eq + Debug>(unwanted: [T], xs: [T]) -> MatchOutcome
    var found: [Str] = []
    for u in unwanted
        let text = u.debug()
        if list.contains(xs, u) and not list.contains(found, text)
            list.push(found, text)
    if list.len(found) == 0
        return matchers.matched()
    matchers.mismatched("contained " + str.join(found, ", "))

// The judgement of `equal_list`: the first index that differs, or the
// length when one list is a prefix of the other.
fn judge_equal_list<T: Eq + Debug>(want: [T], xs: [T]) -> MatchOutcome
    let n = list.len(want)
    for i in 0..list.len(xs)
        if i < n and xs[i] != want[i]
            return matchers.mismatched("element " + str.from_int(i) + " was " + xs[i].debug())
    if list.len(xs) != n
        return list_of_length(xs)
    matchers.matched()

// The judgement of `in_order`: each wanted value found after the one
// before it.
fn judge_in_order<T: Eq + Debug>(want: [T], xs: [T]) -> MatchOutcome
    var next = 0
    for x in xs
        if next < list.len(want) and x == want[next]
            next = next + 1
    if next == list.len(want)
        return matchers.matched()
    if next == 0
        return matchers.mismatched("did not contain " + want[0].debug())
    matchers.mismatched("did not contain " + want[next].debug() + " after " + want[next - 1].debug())

// The judgement of `every_item`: the first element that does not match.
fn judge_every<T>(m: Matcher<T>, xs: [T]) -> MatchOutcome
    for i in 0..list.len(xs)
        let o = matchers.check_that(xs[i], m)
        if not o.ok
            return matchers.mismatched("element " + str.from_int(i) + " " + (o.mismatch ?? ""))
    matchers.matched()

// The judgement of `any_item`.
fn judge_any_item<T>(m: Matcher<T>, xs: [T]) -> MatchOutcome
    for x in xs
        if matchers.matches(m, x)
            return matchers.matched()
    if list.len(xs) == 0
        return matchers.mismatched("was an empty list")
    matchers.mismatched("had " + str.from_int(list.len(xs)) + " elements and none matched")

// The judgement of `item_at`.
fn judge_item_at<T>(index: Int, m: Matcher<T>, xs: [T]) -> MatchOutcome
    if index < 0 or index >= list.len(xs)
        return matchers.mismatched("was a list of length " + str.from_int(list.len(xs)) + ", with no element " + str.from_int(index))
    let o = matchers.check_that(xs[index], m)
    if o.ok
        return o
    matchers.mismatched("element " + str.from_int(index) + " " + (o.mismatch ?? ""))

// The judgement of `has_length_that`.
fn judge_length_that<T>(m: Matcher<Int>, xs: [T]) -> MatchOutcome
    let o = matchers.check_that(list.len(xs), m)
    if o.ok
        return o
    matchers.mismatched("length " + (o.mismatch ?? ""))
