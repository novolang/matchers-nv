// matchvalue.nv — the matchers over one value: equality, ordering and
// closeness.
//
// `equal_to` compares and prints, so it asks for `T: Eq + Debug`.  The
// ordering matchers also need a total order, so they ask for
// `T: Ord + Debug`.
//
// A matcher prints the value it judged with `Debug`, not `Display`.
// SPEC section 3.8.1 gives `Debug` to every struct and enum whose fields
// have it, so `equal_to` over a caller's own type prints that type
// without a formatter.  For the primitive types the two agree.
//
// `close_to` compares floating-point numbers within a tolerance the
// caller gives, because `0.1 + 0.2` is not equal to `0.3`.  There is no
// default tolerance: the right one depends on the calculation.
// `test.assert_approx` in the standard library takes one for the same
// reason.

use matchers

// Equal to a value.
//
// Uses `Eq`, which is value equality and not identity: two structures
// with the same fields are equal when their type says they are.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe_mismatch(matchvalue.equal_to(42), 41))
//     // : was 41
// ```
pub fn equal_to<T: Eq + Debug>(want: T) -> Matcher<T>
    Matcher { judge: x => judge_equal(want, x), expected: "equal to " + want.debug() }

// Not equal to a value.
//
// `matchcombine.is_not(equal_to(x))` judges the same way.  This one's
// sentence is "expected anything but 4" rather than "expected not equal
// to 4".
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.not_equal_to(42)))
//     // : anything but 42
// ```
pub fn not_equal_to<T: Eq + Debug>(unwanted: T) -> Matcher<T>
    Matcher { judge: x => judge_unequal(unwanted, x), expected: "anything but " + unwanted.debug() }

// Within `tolerance` of a value.
//
// `0.1 + 0.2` is not `0.3`, so an equality assertion over a computed
// `Float` fails for a reason unrelated to the code under test.  The
// bound is inclusive.  There is no default tolerance, because the right
// one depends on the calculation.
//
// The mismatch names the difference as well as the value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.close_to(0.3, 0.000001), 0.1 + 0.2)}")
//     // true
// ```
pub fn close_to(want: Float, tolerance: Float) -> Matcher<Float>
    let expected = "a number within " + str.from_float(tolerance) + " of " + str.from_float(want)
    Matcher { judge: x => judge_close(want, tolerance, x), expected: expected }

// Greater than a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.greater_than(17)))
//     // : greater than 17
// ```
pub fn greater_than<T: Ord + Debug>(bound: T) -> Matcher<T>
    Matcher { judge: x => judge_order(bound, x, 1, false),
        expected: "greater than " + bound.debug() }

// Greater than or equal to a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.at_least(18), 18)}")      // true
// ```
pub fn at_least<T: Ord + Debug>(bound: T) -> Matcher<T>
    Matcher { judge: x => judge_order(bound, x, 1, true), expected: "at least " + bound.debug() }

// Less than a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.less_than(18), 18)}")     // false
// ```
pub fn less_than<T: Ord + Debug>(bound: T) -> Matcher<T>
    Matcher { judge: x => judge_order(bound, x, -1, false), expected: "less than " + bound.debug() }

// Less than or equal to a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.at_most(18), 18)}")       // true
// ```
pub fn at_most<T: Ord + Debug>(bound: T) -> Matcher<T>
    Matcher { judge: x => judge_order(bound, x, -1, true), expected: "at most " + bound.debug() }

// Within a range, both ends included.
//
// A half-open range is
// `matchcombine.all_of([at_least(lo), less_than(hi)])`.
//
// `lo` above `hi` matches nothing, and the description says so, so a
// test with its bounds swapped fails with a message that names the
// mistake.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.between(1, 65535)))
//     // : between 1 and 65535
// ```
pub fn between<T: Ord + Debug>(lo: T, hi: T) -> Matcher<T>
    var expected = "between " + lo.debug() + " and " + hi.debug()
    if lo > hi
        expected = expected + ", which no value is, because the bounds are swapped"
    Matcher { judge: x => judge_between(lo, hi, x), expected: expected }

// True.
//
// `equal_to(true)` judges the same way.  This one reads better beside a
// predicate the test has named:
// `assert_that_named("the account is locked", locked, matchvalue.is_true())`.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.is_true()))                 // true
// ```
pub fn is_true() -> Matcher<Bool>
    Matcher { judge: judge_true, expected: "true" }

// False.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.is_false(), false)}")     // true
// ```
pub fn is_false() -> Matcher<Bool>
    Matcher { judge: judge_false, expected: "false" }

// One of a list of values.
//
// `matchcombine.any_of` over a list of `equal_to`s judges the same way.
// This one's description is `one of [2, 3, 5, 7]`.
//
// An empty list matches nothing, and says so.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.one_of([2, 3, 5, 7])))
//     // : one of [2, 3, 5, 7]
// ```
pub fn one_of<T: Eq + Debug>(allowed: [T]) -> Matcher<T>
    Matcher { judge: x => judge_one_of(allowed, x), expected: "one of " + debug_list(allowed) }

// A mismatch that names the value: "was 41".
fn was<T: Debug>(value: T) -> MatchOutcome
    matchers.mismatched("was " + value.debug())

// A list as `Debug` would print it: `[2, 3, 5, 7]`.
pub fn debug_list<T: Debug>(xs: [T]) -> Str
    "[" + str.join(list.map(xs, x => x.debug()), ", ") + "]"

// Whether `x` is within `tolerance` of `want`, and by how much it
// missed when it is not.
fn judge_close(want: Float, tolerance: Float, x: Float) -> MatchOutcome
    var diff = x - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff <= tolerance
        return matchers.matched()
    matchers.mismatched("was " + str.from_float(x) + ", which differs by " + str.from_float(diff))

// The judgement of `is_true`.
fn judge_true(b: Bool) -> MatchOutcome
    if b
        return matchers.matched()
    matchers.mismatched("was false")

// The judgement of `is_false`.
fn judge_false(b: Bool) -> MatchOutcome
    if not b
        return matchers.matched()
    matchers.mismatched("was true")

// The judgement of `equal_to`.
fn judge_equal<T: Eq + Debug>(want: T, x: T) -> MatchOutcome
    if x == want
        return matchers.matched()
    was(x)

// The judgement of `not_equal_to`.
fn judge_unequal<T: Eq + Debug>(unwanted: T, x: T) -> MatchOutcome
    if x != unwanted
        return matchers.matched()
    was(x)

// The judgement of the four ordering matchers: `x` on the `side` of
// `bound` (1 above, -1 below), or equal to it when `or_equal`.
fn judge_order<T: Ord + Debug>(bound: T, x: T, side: Int, or_equal: Bool) -> MatchOutcome
    if or_equal and x == bound
        return matchers.matched()
    if side > 0 and x > bound
        return matchers.matched()
    if side < 0 and x < bound
        return matchers.matched()
    was(x)

// The judgement of `between`.
fn judge_between<T: Ord + Debug>(lo: T, hi: T, x: T) -> MatchOutcome
    if x >= lo and x <= hi
        return matchers.matched()
    was(x)

// The judgement of `one_of`.
fn judge_one_of<T: Eq + Debug>(allowed: [T], x: T) -> MatchOutcome
    if list.contains(allowed, x)
        return matchers.matched()
    was(x)
