// matchvalue.nv — the matchers over one value: equality, ordering,
// closeness.
//
// THE BOUNDS ARE WHERE THE DESIGN SHOWS.  `equal_to` needs to compare
// and to print, so it is `<T: Eq + Debug>`; the ordering matchers need
// a total order too, so they are `<T: Ord + Debug>`.  Both bounds name
// traits with no type argument, which is the only kind SPEC § 3.6's
// grammar has — the matcher itself is a struct rather than a trait for
// exactly that reason, and the constructors are where the traits are
// still usable.
//
// `Debug` RATHER THAN `Display`, and the choice matters: SPEC § 3.8.1
// gives every struct and enum a `Debug` implicitly wherever its fields
// have one, so `equal_to(some_invoice)` prints that invoice without the
// caller writing anything.  `Display` is a trait a type opts into, and
// requiring it would mean a matcher over a caller's own type did not
// compile until the caller wrote a formatter — which is a bad first
// experience for the one library whose job is a readable message.  For
// the four primitives the two agree.
//
// FLOATING POINT IS THE ONE PLACE A MATCHER LIBRARY EARNS ITS KEEP.
// `equal_to(0.1 + 0.2)` against `0.3` is false and every person writing
// it believed otherwise, so `close_to` is here with an explicit
// tolerance and no default — because the right tolerance is a property
// of the calculation and not of this package, and a default would be
// this package guessing about somebody's numerics.  `test.assert_approx`
// in the standard library takes one for the same reason.

use matchers

// Equal to a value.
//
// Uses `Eq`, which is value equality and not identity: two structures
// with the same fields are equal when their type says they are.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe_mismatch(matchvalue.equal_to(42), 41))
//     // : was 41
// ```
pub fn equal_to<T: Eq + Debug>(want: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.equal_to")

// Not equal to a value.
//
// `matchcombine.is_not(equal_to(x))` says the same thing and reads
// worse — "expected not equal to 4" rather than "expected anything but
// 4" — so this exists to write the better sentence rather than to add a
// capability.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.not_equal_to(42)))
//     // : anything but 42
// ```
pub fn not_equal_to<T: Eq + Debug>(unwanted: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.not_equal_to")

// Within `tolerance` of a value.
//
// **The matcher a floating-point test actually wants.**  `0.1 + 0.2` is
// not `0.3` and never will be, so an equality assertion over a computed
// `Float` is a test that fails for a reason unrelated to the code it is
// testing.
//
// There is no default tolerance, deliberately: the right one is a
// property of the calculation — how many operations, over what
// magnitudes — and a default would be this package guessing about
// somebody else's numerics and being wrong quietly.
//
// The mismatch names the difference as well as the value, because
// "was 0.30000000000000004" alone does not tell a reader whether they
// need a bigger tolerance or a different algorithm.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.close_to(0.3, 0.000001), 0.1 + 0.2)}")
//     // true
// ```
pub fn close_to(want: Float, tolerance: Float) -> Matcher<Float>
    todo("matchers-nv.matchvalue.close_to")

// Greater than a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.greater_than(17)))
//     // : greater than 17
// ```
pub fn greater_than<T: Ord + Debug>(bound: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.greater_than")

// Greater than or equal to a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.at_least(18), 18)}")      // true
// ```
pub fn at_least<T: Ord + Debug>(bound: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.at_least")

// Less than a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.less_than(18), 18)}")     // false
// ```
pub fn less_than<T: Ord + Debug>(bound: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.less_than")

// Less than or equal to a value.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.at_most(18), 18)}")       // true
// ```
pub fn at_most<T: Ord + Debug>(bound: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.at_most")

// Within a range, both ends included.
//
// Inclusive at both ends because that is what a person writing
// `between(1, 65535)` means, and because an exclusive upper bound
// spelled `between` is the off-by-one every range API has argued about.
// A caller who wants a half-open range says
// `matchcombine.all_of([at_least(lo), less_than(hi)])`.
//
// `Lo` above `hi` is not a refusal — a matcher has nowhere to put one —
// but it matches nothing, and its description says so, so a test with
// its bounds swapped fails with a message that names the mistake.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.between(1, 65535)))
//     // : between 1 and 65535
// ```
pub fn between<T: Ord + Debug>(lo: T, hi: T) -> Matcher<T>
    todo("matchers-nv.matchvalue.between")

// True.
//
// `equal_to(true)` says the same thing; this reads better in the place
// it is used, which is a predicate the test has already named —
// `assert_that_named("the account is locked", locked, matchvalue.is_true())`.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.is_true()))                 // true
// ```
pub fn is_true() -> Matcher<Bool>
    todo("matchers-nv.matchvalue.is_true")

// False.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println("${matchers.matches(matchvalue.is_false(), false)}")     // true
// ```
pub fn is_false() -> Matcher<Bool>
    todo("matchers-nv.matchvalue.is_false")

// One of a list of values.
//
// `matchcombine.any_of` over a list of `equal_to`s says the same thing
// and its generated description is a sentence nobody wants to read.
// This one says `one of [2, 3, 5, 7]`.
//
// An empty list matches nothing, and says so.
//
// ```novo
// use matchers
// use matchvalue
//
// fn main() [io]
//     println(matchers.describe(matchvalue.one_of([2, 3, 5, 7])))
//     // : one of [2, 3, 5, 7]
// ```
pub fn one_of<T: Eq + Debug>(allowed: [T]) -> Matcher<T>
    todo("matchers-nv.matchvalue.one_of")
