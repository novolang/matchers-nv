// matchresult.nv — the matchers over a `Result` and an optional.
//
// A match written by hand over a `Result`,
//
//     match parse(text)
//         Err(_) => test.assert(false)
//         Ok(v)  => test.assert(v == 42)
//
// fails with `expected true` whether the text did not parse or parsed
// to 41.  `is_ok_with(matchvalue.equal_to(42))` fails with
// `was an error: ...` in the first case and `was 41` in the second.
//
// The error side has two matchers.  `is_err` passes for any error, so
// it still passes when a function starts failing for another reason.
// `is_err_with` takes a matcher over the error, for a test about one
// refusal.
//
// `is_ok<T, E>` names both type parameters, because the value it judges
// is a `Result<T, E>`.  Neither appears in an argument, so a call site
// closes them from an annotated binding or another typed position
// (error E2016).

use matchers

// An `Ok`, with any value.
//
// For a test whose point is that the call succeeded.  The mismatch
// prints the error, because "it failed" without the reason is the least
// useful message a failing test can produce.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<Result<Int, Str>> = matchresult.is_ok()
//     println("${matchers.matches(m, Ok(42))}")             // true
// ```
pub fn is_ok<T, E: Debug>() -> Matcher<Result<T, E>>
    Matcher { judge: judge_ok, expected: "an Ok" }

// An `Ok` whose value matches.
//
// Its mismatch tells "did not succeed" from "succeeded with the wrong
// value": `was an error: ...` in the first case, and the inner
// matcher's mismatch in the second.
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let want = matchvalue.equal_to(42)
//     let m: Matcher<Result<Int, Str>> = matchresult.is_ok_with(want)
//     println("${matchers.matches(m, Ok(41))}")             // false
// ```
pub fn is_ok_with<T, E: Debug>(inner: Matcher<T>) -> Matcher<Result<T, E>>
    Matcher { judge: r => judge_ok_with(inner, r),
        expected: "Ok(" + matchers.describe(inner) + ")" }

// An `Err`, with any error.
//
// A test that asserts only this keeps passing when the function starts
// failing for another reason.  `is_err_with` takes a matcher over the
// error, for a test that knows which error it means.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<Result<Int, Str>> = matchresult.is_err()
//     println("${matchers.matches(m, Ok(42))}")             // false
// ```
pub fn is_err<T: Debug, E>() -> Matcher<Result<T, E>>
    Matcher { judge: judge_err, expected: "an error" }

// An `Err` whose error matches.
//
// The error side of `is_ok_with`, for a test about one refusal: not
// "it failed" but "it failed with `BadMagic` at byte zero".
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let want = matchvalue.equal_to("no")
//     let m: Matcher<Result<Int, Str>> = matchresult.is_err_with(want)
//     println("${matchers.matches(m, Err("no"))}")          // true
// ```
pub fn is_err_with<T: Debug, E>(inner: Matcher<E>) -> Matcher<Result<T, E>>
    Matcher { judge: r => judge_err_with(inner, r),
        expected: "Err(" + matchers.describe(inner) + ")" }

// A `Some`, with any value.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<?Int> = matchresult.is_some()
//     println("${matchers.matches(m, Some(5))}")            // true
// ```
pub fn is_some<T>() -> Matcher<?T>
    Matcher { judge: judge_some, expected: "a Some" }

// A `Some` whose value matches.
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let m: Matcher<?Int> = matchresult.is_some_with(matchvalue.equal_to(5))
//     println(matchers.describe(m))
//     // : Some(equal to 5)
// ```
pub fn is_some_with<T>(inner: Matcher<T>) -> Matcher<?T>
    Matcher { judge: o => judge_some_with(inner, o),
        expected: "Some(" + matchers.describe(inner) + ")" }

// A `None`.
//
// The mismatch prints the value that was there instead.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<?Int> = matchresult.is_none()
//     println(matchers.describe_mismatch(m, Some(5)))
//     // : was Some(5)
// ```
pub fn is_none<T: Debug>() -> Matcher<?T>
    Matcher { judge: judge_none, expected: "None" }

// The value inside an `Ok`, judged by a matcher, with the `Err` side
// counted as a mismatch.
//
// It judges like `is_ok_with` and describes itself with the inner
// matcher's sentence alone, so it reads well inside another matcher.
// `matchcombine.field_of("parsed", read_parsed,
// matchresult.unwrapped(matchvalue.equal_to(42)))` reads a `Result`
// field of a struct and judges the value inside it.
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let want = matchvalue.equal_to(42)
//     let m: Matcher<Result<Int, Str>> = matchresult.unwrapped(want)
//     println("${matchers.matches(m, Ok(42))}")             // true
// ```
pub fn unwrapped<T, E: Debug>(inner: Matcher<T>) -> Matcher<Result<T, E>>
    Matcher { judge: r => judge_ok_with(inner, r), expected: matchers.describe(inner) }

// The judgement of `is_ok`.
fn judge_ok<T, E: Debug>(r: Result<T, E>) -> MatchOutcome
    match r
        Ok(_)  => matchers.matched()
        Err(e) => matchers.mismatched("was an error: " + e.debug())

// The judgement of `is_ok_with` and `unwrapped`.
fn judge_ok_with<T, E: Debug>(inner: Matcher<T>, r: Result<T, E>) -> MatchOutcome
    match r
        Ok(v)  => matchers.check_that(v, inner)
        Err(e) => matchers.mismatched("was an error: " + e.debug())

// The judgement of `is_err`.
fn judge_err<T: Debug, E>(r: Result<T, E>) -> MatchOutcome
    match r
        Ok(v)  => matchers.mismatched("was Ok(" + v.debug() + ")")
        Err(_) => matchers.matched()

// The judgement of `is_err_with`.
fn judge_err_with<T: Debug, E>(inner: Matcher<E>, r: Result<T, E>) -> MatchOutcome
    match r
        Ok(v)  => matchers.mismatched("was Ok(" + v.debug() + ")")
        Err(e) =>
            let o = matchers.check_that(e, inner)
            if o.ok
                return o
            matchers.mismatched("error " + (o.mismatch ?? ""))

// The judgement of `is_some`.
fn judge_some<T>(o: ?T) -> MatchOutcome
    match o
        Some(_) => matchers.matched()
        None    => matchers.mismatched("was None")

// The judgement of `is_some_with`.
fn judge_some_with<T>(inner: Matcher<T>, o: ?T) -> MatchOutcome
    match o
        Some(v) => matchers.check_that(v, inner)
        None    => matchers.mismatched("was None")

// The judgement of `is_none`.
fn judge_none<T: Debug>(o: ?T) -> MatchOutcome
    match o
        Some(v) => matchers.mismatched("was Some(" + v.debug() + ")")
        None    => matchers.matched()
