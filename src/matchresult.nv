// matchresult.nv — the matchers over a `Result` and an optional.
//
// THE ASSERTION THIS MODULE REPLACES IS THE WORST ONE IN A SUITE:
//
//     match parse(text)
//         Err(_) => test.assert(false)
//         Ok(v)  => test.assert(v == 42)
//
// Four lines, and when it fails it says `expected true` — with no way to
// tell "it did not parse" from "it parsed to 41", which are different
// bugs.  `matchers.assert_that(parse(text), matchresult.is_ok_with(
// matchvalue.equal_to(42)))` is one line and fails with either
// `"was an error: unexpected end of input"` or `"was Ok(41)"`.
//
// WHY THE ERROR SIDE IS TWO MATCHERS.  `is_err` says only that it
// failed, which is what most tests of a refusal mean; `is_err_with`
// takes a matcher over the error, which is what a test of a SPECIFIC
// refusal means.  Keeping them apart matters because `is_err` alone is
// the assertion that passes for the wrong reason more often than any
// other in a suite — a function that started failing for a new reason
// still satisfies it.  This module cannot stop that; naming the two
// separately at least makes the weaker one visible in the test's own
// text.
//
// BOTH TYPE PARAMETERS ARE NAMED EVEN WHERE ONE IS UNUSED.
// `is_ok<T, E>` has to mention `E` because the value it judges is a
// `Result<T, E>`, and there is nothing in the call to close it from — so
// a call site binds it with an annotation or by flowing into a concrete
// position.  That is the language's inference and not this package's
// choice, and the README says where it shows.

use matchers

// An `Ok`, with any value.
//
// For a test whose point is that the call succeeded.  The mismatch
// prints the error, because "it failed" without the reason is the least
// useful message a failing test can produce.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<Result<Int, Str>> = matchresult.is_ok()
//     println("${matchers.matches(m, Ok(42))}")             // true
// ```
pub fn is_ok<T, E: Debug>() -> Matcher<Result<T, E>>
    todo("matchers-nv.matchresult.is_ok")

// An `Ok` whose value matches.
//
// **The one this module exists for.**  One assertion where the
// hand-written form is four lines, and one message that distinguishes
// "did not succeed" from "succeeded with the wrong value" — which the
// hand-written form cannot, because by the time it reaches
// `test.assert(v == 42)` it has already thrown the error away.
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let want = matchvalue.equal_to(42)
//     let m: Matcher<Result<Int, Str>> = matchresult.is_ok_with(want)
//     println("${matchers.matches(m, Ok(41))}")             // false
// ```
pub fn is_ok_with<T, E: Debug>(inner: Matcher<T>) -> Matcher<Result<T, E>>
    todo("matchers-nv.matchresult.is_ok_with")

// An `Err`, with any error.
//
// **The weakest assertion in this package, and it says so.**  A test
// that asserts only this keeps passing when the function starts failing
// for an unrelated reason, which is the failure mode of every
// "expect an error" test ever written.  `is_err_with` is the one to
// reach for when the test knows which error it means — and it almost
// always does.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<Result<Int, Str>> = matchresult.is_err()
//     println("${matchers.matches(m, Ok(42))}")             // false
// ```
pub fn is_err<T: Debug, E>() -> Matcher<Result<T, E>>
    todo("matchers-nv.matchresult.is_err")

// An `Err` whose error matches.
//
// The error side of `is_ok_with`, and the assertion a test of a
// refusal should be written with: not "it failed" but "it failed with
// `BadMagic` at byte zero".
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let want = matchvalue.equal_to("no")
//     let m: Matcher<Result<Int, Str>> = matchresult.is_err_with(want)
//     println("${matchers.matches(m, Err("no"))}")          // true
// ```
pub fn is_err_with<T: Debug, E>(inner: Matcher<E>) -> Matcher<Result<T, E>>
    todo("matchers-nv.matchresult.is_err_with")

// A `Some`, with any value.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<?Int> = matchresult.is_some()
//     println("${matchers.matches(m, Some(5))}")            // true
// ```
pub fn is_some<T>() -> Matcher<?T>
    todo("matchers-nv.matchresult.is_some")

// A `Some` whose value matches.
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let m: Matcher<?Int> = matchresult.is_some_with(matchvalue.equal_to(5))
//     println(matchers.describe(m))
//     // : Some(equal to 5)
// ```
pub fn is_some_with<T>(inner: Matcher<T>) -> Matcher<?T>
    todo("matchers-nv.matchresult.is_some_with")

// A `None`.
//
// The mismatch prints what was there instead, which is the whole
// question a failing "should be absent" test raises.
//
// ```novo
// use matchers
// use matchresult
//
// fn main() [io]
//     let m: Matcher<?Int> = matchresult.is_none()
//     println(matchers.describe_mismatch(m, Some(5)))
//     // : was Some(5)
// ```
pub fn is_none<T: Debug>() -> Matcher<?T>
    todo("matchers-nv.matchresult.is_none")

// The value inside an `Ok`, judged by a matcher, with the `Err` side
// counted as a mismatch.
//
// `is_ok_with` under another name?  No: this is the projection form, for
// composing INTO something else.  `matchcombine.field_of("parsed",
// read_parsed, matchresult.unwrapped(matchvalue.equal_to(42)))` reads a
// `Result` field of a struct and judges its value, which the assertion
// forms cannot do because they are the outermost matcher by
// construction.
//
// ```novo
// use matchers
// use matchresult
// use matchvalue
//
// fn main() [io]
//     let want = matchvalue.equal_to(42)
//     let m: Matcher<Result<Int, Str>> = matchresult.unwrapped(want)
//     println("${matchers.matches(m, Ok(42))}")             // true
// ```
pub fn unwrapped<T, E: Debug>(inner: Matcher<T>) -> Matcher<Result<T, E>>
    todo("matchers-nv.matchresult.unwrapped")
