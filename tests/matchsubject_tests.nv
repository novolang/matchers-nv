// matchsubject_tests.nv — the API suite for the matchers over a
// string, a list, a `Result` and an optional.
//
// Some matchers look interchangeable and are not: `contains_all`,
// `in_order` and `equal_list`; `matches_regex` and `contains_regex`;
// `is_err` and `is_err_with`.  Each group is asserted against one input
// with the case that separates its members.
//
// The regular-expression cases state their dialect.  `std.regex` is a
// Perl-flavoured subset, and I-Regexp (RFC 9485) is the portable core
// inside it.  The suite checks that a portable pattern reports nothing
// from `unportable_construct`, and that each construct outside the core
// is named.

use std.test
use matchers
use matchtext
use matchcoll
use matchresult
use matchvalue

@test
fn test_the_string_matchers_fail_with_the_part_that_mattered() [io]
    test.case("prefixes and suffixes")
    test.assert(matchers.matches(matchtext.starts_with("Bearer "), "Bearer abc"))
    test.assert(matchers.matches(matchtext.starts_with("Bearer "), "Basic abc")
                == false)
    test.assert(matchers.matches(matchtext.ends_with(".zst"), "x.zst"))
    test.assert(matchers.matches(matchtext.ends_with(".zst"), "x.lz4") == false)

    test.case("the description is a noun phrase with the needle in it")
    test.assert(matchers.describe(matchtext.starts_with("Bearer "))
                == "a string starting with \"Bearer \"")

    test.case("substrings, which are not the list matcher of the same idea")
    test.assert(matchers.matches(matchtext.contains_text("ok"), "not ok"))
    test.assert(matchers.matches(matchtext.contains_text("ok"), "no") == false)

    test.case("ASCII case folding, and the name does not claim more")
    test.assert(matchers.matches(matchtext.equal_ignoring_case("GET"), "get"))
    test.assert(matchers.matches(matchtext.equal_ignoring_case("GET"), "put")
                == false)

    test.case("trimming, for output whose newline is an accident")
    test.assert(matchers.matches(matchtext.equal_trimmed("ok"), "ok\n"))
    test.assert(matchers.matches(matchtext.equal_trimmed("ok"), " ok "))
    test.assert(matchers.matches(matchtext.equal_trimmed("ok"), "o k") == false)

    test.case("the empty string, and a length in BYTES")
    test.assert(matchers.matches(matchtext.is_blank(), ""))
    test.assert(matchers.matches(matchtext.is_blank(), " ") == false)
    test.assert(matchers.matches(matchtext.has_text_length(3), "abc"))
    test.assert(matchers.matches(matchtext.has_text_length(3), "ab") == false)

@test
fn test_a_whole_match_and_a_search_are_different_assertions() [io]
    test.case("matches_regex is the whole string")
    test.assert(matchers.matches(matchtext.matches_regex("[0-9]{4}"), "2026"))
    test.assert(matchers.matches(matchtext.matches_regex("[0-9]{4}"), "in 2026")
                == false)

    test.case("contains_regex is any substring")
    test.assert(matchers.matches(matchtext.contains_regex("[0-9]+"), "in 2026"))
    test.assert(matchers.matches(matchtext.contains_regex("[0-9]+"), "none")
                == false)

    test.case("a pattern that does not compile matches nothing and says which")
    // Never a silent "no match", which a reader cannot tell from a
    // working pattern that did not match.
    test.assert(matchtext.is_valid_pattern("[0-9]"))
    test.assert(matchtext.is_valid_pattern("[0-9") == false)
    test.assert(matchers.matches(matchtext.matches_regex("[0-9"), "2026") == false)
    test.assert(matchers.describe_mismatch(matchtext.matches_regex("[0-9"), "2026")
                != "")

@test
fn test_a_long_subject_is_shown_as_its_start_and_its_length() [io]
    test.case("a short subject is shown in full")
    test.assert(matchtext.shown("abc") == "\"abc\"")

    test.case("a long one is cut at 64 bytes")
    let long = str.repeat("a", 100)
    test.assert(matchtext.shown(long) == "\"" + str.repeat("a", 64) + "\"... (100 bytes)")
    test.assert(matchers.describe_mismatch(matchtext.starts_with("b"), long)
                == "was \"" + str.repeat("a", 64) + "\"... (100 bytes)")

@test
fn test_the_portable_subset_is_reported_and_not_refused() [io]
    test.case("a pattern inside I-Regexp reports nothing")
    test.assert(matchtext.unportable_construct("[0-9]{4}-[0-9]{2}") == None)
    test.assert(matchtext.unportable_construct("a|b") == None)
    test.assert(matchtext.unportable_construct("(ab)+c?") == None)

    test.case("and each construct outside it is named")
    test.assert(matchtext.unportable_construct("^abc") == Some("anchor"))
    test.assert(matchtext.unportable_construct("abc$") == Some("anchor"))
    test.assert(matchtext.unportable_construct("a*?") == Some("lazy quantifier"))
    test.assert(matchtext.unportable_construct("\\babc") == Some("word boundary"))
    test.assert(matchtext.unportable_construct("[[:alpha:]]") == Some("POSIX class"))
    test.assert(matchtext.unportable_construct("(a)\\1") == Some("backreference"))
    test.assert(matchtext.unportable_construct("\\d+") == Some("shorthand class"))
    test.assert(matchtext.unportable_construct("\\Aabc") == Some("anchor"))
    test.assert(matchtext.unportable_construct("(?=a)b") == Some("lookaround"))
    test.assert(matchtext.unportable_construct("(?i)abc") == Some("group option"))

    test.case("an escaped character, and a class that closes, are portable")
    test.assert(matchtext.unportable_construct("a\\.b\\^") == None)
    test.assert(matchtext.unportable_construct("[ab]c") == None)

    test.case("but it is still a matcher, because a test need not be portable")
    // jsonpath-nv refuses, because a query crosses a wire and has to
    // mean the same thing on the other side.  A test does not.
    test.assert(matchers.matches(matchtext.contains_regex("\\bok\\b"), "it is ok"))

@test
fn test_the_list_matchers_say_which_element() [io]
    test.case("a length, and the failure says what it was")
    let three: Matcher<[Int]> = matchcoll.has_len(3)
    test.assert(matchers.matches(three, [1, 2, 3]))
    test.assert(matchers.matches(three, [1, 2]) == false)
    test.assert(matchers.describe_mismatch(three, [1, 2]) == "was a list of length 2")

    test.case("empty and not empty")
    let empty: Matcher<[Int]> = matchcoll.is_empty()
    let some: Matcher<[Int]> = matchcoll.is_not_empty()
    test.assert(matchers.matches(empty, []))
    test.assert(matchers.matches(empty, [1]) == false)
    test.assert(matchers.matches(some, [1]))
    test.assert(matchers.matches(some, []) == false)

    test.case("a length judged by a matcher, for a bound rather than a number")
    let bounded: Matcher<[Int]> = matchcoll.has_length_that(matchvalue.between(1, 3))
    test.assert(matchers.matches(bounded, [1, 2]))
    test.assert(matchers.matches(bounded, []) == false)

@test
fn test_membership_order_and_equality_are_three_questions() [io]
    test.case("membership says nothing about position")
    let has7: Matcher<[Int]> = matchcoll.contains(7)
    test.assert(matchers.matches(has7, [1, 7, 3]))
    test.assert(matchers.matches(has7, [3, 7, 1]))
    test.assert(matchers.matches(has7, [1, 2, 3]) == false)

    test.case("contains_all is set membership, so duplicates do not count")
    let both: Matcher<[Int]> = matchcoll.contains_all([7, 7])
    test.assert(matchers.matches(both, [7]))
    let two: Matcher<[Int]> = matchcoll.contains_all([2, 9])
    test.assert(matchers.matches(two, [9, 1, 2]))
    test.assert(matchers.describe_mismatch(two, [1, 2]) == "did not contain 9")

    test.case("contains_none is its complement")
    let none: Matcher<[Int]> = matchcoll.contains_none([9])
    test.assert(matchers.matches(none, [1, 2]))
    test.assert(matchers.matches(none, [1, 9]) == false)

    test.case("in_order allows anything between, and equal_list does not")
    let ordered: Matcher<[Int]> = matchcoll.in_order([1, 3])
    test.assert(matchers.matches(ordered, [1, 2, 3]))
    test.assert(matchers.matches(ordered, [3, 2, 1]) == false)
    let exact: Matcher<[Int]> = matchcoll.equal_list([1, 3])
    test.assert(matchers.matches(exact, [1, 3]))
    test.assert(matchers.matches(exact, [1, 2, 3]) == false)

    test.case("and equal_list names the first index that differed")
    let pair: Matcher<[Int]> = matchcoll.equal_list([1, 2])
    test.assert(matchers.describe_mismatch(pair, [1, 3]) == "element 1 was 3")

@test
fn test_the_quantifiers_name_the_element_that_failed() [io]
    test.case("every element, and an empty list passes")
    let all_ok: Matcher<[Int]> = matchcoll.every_item(matchvalue.at_least(0))
    test.assert(matchers.matches(all_ok, [0, 1, 2]))
    test.assert(matchers.matches(all_ok, []))
    test.assert(matchers.matches(all_ok, [1, 0 - 1]) == false)

    test.case("and the failure names the index, which a loop never does")
    test.assert(matchers.describe_mismatch(all_ok, [1, 0 - 1]) == "element 1 was -1")

    test.case("at least one, and an empty list does not pass")
    let any_big: Matcher<[Int]> = matchcoll.any_item(matchvalue.greater_than(2))
    test.assert(matchers.matches(any_big, [1, 2, 3]))
    test.assert(matchers.matches(any_big, [1, 2]) == false)
    test.assert(matchers.matches(any_big, []) == false)

    test.case("an index, and an index past the end says the length instead")
    let at1: Matcher<[Int]> = matchcoll.item_at(1, matchvalue.equal_to(2))
    test.assert(matchers.matches(at1, [1, 2, 3]))
    test.assert(matchers.matches(at1, [1, 9]) == false)
    let at5: Matcher<[Int]> = matchcoll.item_at(5, matchvalue.equal_to(1))
    test.assert(matchers.describe_mismatch(at5, [1, 2])
                == "was a list of length 2, with no element 5")

@test
fn test_a_result_matcher_tells_a_failure_from_a_wrong_value() [io]
    test.case("an Ok with any value")
    let ok: Matcher<Result<Int, Str>> = matchresult.is_ok()
    test.assert(matchers.matches(ok, Ok(42)))
    test.assert(matchers.matches(ok, Err("no")) == false)

    test.case("and the mismatch prints the error, which is the useful part")
    test.assert(matchers.describe_mismatch(ok, Err("no")) == "was an error: \"no\"")

    test.case("an Ok whose value matches — the four-line assertion, in one")
    let want: Matcher<Int> = matchvalue.equal_to(42)
    let right: Matcher<Result<Int, Str>> = matchresult.is_ok_with(want)
    test.assert(matchers.matches(right, Ok(42)))
    test.assert(matchers.matches(right, Ok(41)) == false)
    test.assert(matchers.matches(right, Err("no")) == false)

    test.case("and the two failures are distinguishable, which is the point")
    test.assert(matchers.describe_mismatch(right, Ok(41))
                != matchers.describe_mismatch(right, Err("no")))

@test
fn test_is_err_is_the_weak_one_and_is_err_with_is_not() [io]
    test.case("an Err with any error passes for any reason at all")
    let bad: Matcher<Result<Int, Str>> = matchresult.is_err()
    test.assert(matchers.matches(bad, Err("no")))
    test.assert(matchers.matches(bad, Err("something else entirely")))
    test.assert(matchers.matches(bad, Ok(42)) == false)

    test.case("an Err whose error matches does not")
    let want: Matcher<Str> = matchvalue.equal_to("no")
    let named: Matcher<Result<Int, Str>> = matchresult.is_err_with(want)
    test.assert(matchers.matches(named, Err("no")))
    test.assert(matchers.matches(named, Err("something else entirely")) == false)
    test.assert(matchers.matches(named, Ok(42)) == false)

@test
fn test_the_optional_matchers_print_what_was_there_instead() [io]
    test.case("Some, with any value")
    let some: Matcher<?Int> = matchresult.is_some()
    test.assert(matchers.matches(some, Some(5)))
    test.assert(matchers.matches(some, None) == false)

    test.case("Some whose value matches")
    let five: Matcher<?Int> = matchresult.is_some_with(matchvalue.equal_to(5))
    test.assert(matchers.matches(five, Some(5)))
    test.assert(matchers.matches(five, Some(4)) == false)
    test.assert(matchers.matches(five, None) == false)
    test.assert(matchers.describe(five) == "Some(equal to 5)")

    test.case("None, and its mismatch prints what was there")
    let none: Matcher<?Int> = matchresult.is_none()
    test.assert(matchers.matches(none, None))
    test.assert(matchers.matches(none, Some(5)) == false)
    test.assert(matchers.describe_mismatch(none, Some(5)) == "was Some(5)")

    test.case("and unwrapped is the projection form, for composing inward")
    let inner: Matcher<Int> = matchvalue.equal_to(42)
    let u: Matcher<Result<Int, Str>> = matchresult.unwrapped(inner)
    test.assert(matchers.matches(u, Ok(42)))
    test.assert(matchers.matches(u, Ok(41)) == false)
    test.assert(matchers.matches(u, Err("no")) == false)
